# Shared configuration for the whole project. Copy to `.env` (start.sh does this for you).

# --- Ports used by start.sh ---
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- Sign in with GitHub (required) ---
# Create an OAuth app at https://github.com/settings/developers → "New OAuth App":
#   Homepage URL:                http://localhost:3000
#   Authorization callback URL:  http://localhost:3000/api/auth/github/callback
HABIT_GITHUB_CLIENT_ID=
HABIT_GITHUB_CLIENT_SECRET=
# Optional: comma-separated GitHub usernames who sign in directly, no approval needed
# (empty = any GitHub account). When this or HABIT_ADMIN_GITHUB_USERS is set, the app is
# invite-only and the login page offers "Request access".
HABIT_ALLOWED_GITHUB_USERS=
# Who reviews access requests (Account menu → Access requests). Admins can always sign in.
HABIT_ADMIN_GITHUB_USERS=

# The URL you open in the browser. Must match the OAuth app's URLs. Use https:// when deployed
# (session cookies then become Secure-only).
HABIT_PUBLIC_URL=http://localhost:3000

# --- Email for new access requests (optional; any SMTP provider) ---
# Port 587 uses STARTTLS, 465 uses TLS. Leave HABIT_SMTP_HOST empty to disable email.
HABIT_SMTP_HOST=
HABIT_SMTP_PORT=587
HABIT_SMTP_USERNAME=
HABIT_SMTP_PASSWORD=
HABIT_SMTP_FROM=
HABIT_NOTIFY_EMAIL=

# --- Optional ---
# Public GitHub repository, linked from the About page (/about).
# NEXT_PUBLIC_REPO_URL=https://github.com/<you>/<repo>
# HABIT_DATABASE_URL=sqlite:////absolute/path/to/habits.db   # default: data/habits.db
# HABIT_SESSION_DAYS=30
